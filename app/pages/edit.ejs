<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Edit your redirect</title>
    <link rel="stylesheet" href="/edit.css">
  </head>
  <body>
    <main class="editor">
      <header class="page-header">
        <span class="link-mark" aria-hidden="true">↗</span>
        <h1>Edit your redirect</h1>
      </header>

      <section class="card" aria-label="Redirect settings">
        <form method="post" action="/edit" onsubmit="navigator.clipboard.writeText('https://' + window.location.host)">
          <div class="field">
            <label for="redirect-url">Destination URL</label>
            <div class="url-input">
              <input id="redirect-url" name="redirectUrl" type="text" inputmode="url" autocomplete="url" placeholder="https://example.com" value="<%= redirectUrl %>" required aria-describedby="url-hint">
              <button class="clear-button" type="button" onclick="this.form.elements.redirectUrl.value = ''; this.form.elements.redirectUrl.focus()">Clear</button>
            </div>
            <p class="hint" id="url-hint">The address visitors will be redirected to.</p>
          </div>

          <div class="field">
            <label for="password">Password</label>
            <input id="password" name="password" type="password" autocomplete="current-password" placeholder="Enter password" required>
          </div>

          <button type="submit">Save<span aria-hidden="true">↗</span></button>
          <p class="save-note">Changes take effect immediately.</p>
        </form>

        <div class="visits">
          <span>Total visits</span>
          <strong><%= hitCount %></strong>
        </div>
      </section>
    </main>
  </body>
</html>
